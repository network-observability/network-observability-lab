######################################################
# Metric Queries Examples
######################################################

# Per-interface inbound bps
rate(interface_in_octets{device="$device"}[5m]) * 8

# Per-interface outbound bps
rate(interface_out_octets{device="$device"}[5m]) * 8

# Total traffic (in+out) bps (device-wide)
sum(
  rate(interface_in_octets{device="$device"}[5m]) * 8
+
  rate(interface_out_octets{device="$device"}[5m]) * 8
)

# Sum of traffic inbound on a device EXCLUDING OOB traffic
sum(
    rate(
        interface_in_octets{device="srl2", name!~"mgmt0.*"}[2m]
    )
) * 8

# Same as before but on a per-device basis
sum by (device) (
    rate(
        interface_in_octets{name!~"mgmt0.*"}[2m]
    )
) * 8